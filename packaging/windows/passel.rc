// Resources linked into passel.exe (build.rs): the icon Explorer, the
// taskbar and the title bar show, and the details in its Properties.
// PASSEL_VERSION_* and PASSEL_ICON come from build.rs.

#include <winver.h>

1 ICON PASSEL_ICON

VS_VERSION_INFO VERSIONINFO
FILEVERSION PASSEL_VERSION_MAJOR, PASSEL_VERSION_MINOR, PASSEL_VERSION_PATCH, 0
PRODUCTVERSION PASSEL_VERSION_MAJOR, PASSEL_VERSION_MINOR, PASSEL_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Pierre Sauvage"
      VALUE "FileDescription", "Passel"
      VALUE "FileVersion", PASSEL_VERSION
      VALUE "InternalName", "passel"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "passel.exe"
      VALUE "ProductName", "Passel"
      VALUE "ProductVersion", PASSEL_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
