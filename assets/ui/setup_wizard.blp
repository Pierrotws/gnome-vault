using Gtk 4.0;
using Adw 1;
translation-domain "passel";

template $SetupWizard : Adw.Bin {
    child: Adw.NavigationView navigation {
        Adw.NavigationPage {
            tag: "welcome";
            title: _("Welcome");

            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    show-back-button: false;
                }

                content: Adw.StatusPage {
                    icon-name: "dialog-password-symbolic";
                    title: _("Welcome to Passel");
                    description: _("Passel keeps your passwords in an encrypted folder that works with pass. Let’s set one up.");

                    child: Box {
                        orientation: vertical;
                        halign: center;
                        spacing: 12;

                        Button create_button {
                            label: _("Create a New Vault");
                            css-classes: ["suggested-action", "pill"];
                        }

                        Button download_button {
                            label: _("I Already Have a Vault");
                            css-classes: ["pill"];
                        }
                    };
                };
            };
        }

        Adw.NavigationPage {
            tag: "vault";
            title: _("Vault");

            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    show-back-button: false;
                }

                content: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                        maximum-size: 560;
                        valign: center;
                        margin-top: 24;
                        margin-bottom: 24;
                        margin-start: 24;
                        margin-end: 24;

                        child: Box {
                            orientation: vertical;
                            spacing: 18;

                            Label {
                                label: _("Your Vault");
                                css-classes: ["title-1"];
                            }

                            Label {
                                label: _("Choose the folder that will hold your encrypted entries.");
                                wrap: true;
                                xalign: 0;
                                css-classes: ["dim-label"];
                            }

                            Adw.PreferencesGroup vault_group {
                                Adw.EntryRow path_row {
                                    title: _("Folder");
                                }

                            }

                            Box {
                                halign: end;
                                spacing: 12;

                                Button vault_back_button {
                                    label: _("Back");
                                }

                                Button vault_next_button {
                                    label: _("Next");
                                    css-classes: ["suggested-action"];
                                }
                            }
                        };
                    };
                };
            };
        }

        Adw.NavigationPage {
            tag: "key";
            title: _("Encryption Key");

            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    show-back-button: false;
                }

                content: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                        maximum-size: 560;
                        valign: center;
                        margin-top: 24;
                        margin-bottom: 24;
                        margin-start: 24;
                        margin-end: 24;

                        child: Box {
                            orientation: vertical;
                            spacing: 18;

                            Label {
                                label: _("Your Encryption Key");
                                wrap: true;
                                css-classes: ["title-1"];
                            }

                            Label key_description {
                                label: _("Passel encrypts every entry with a GPG key. Only this key, unlocked with its passphrase, can open them.");
                                wrap: true;
                                xalign: 0;
                                css-classes: ["dim-label"];
                            }

                            Adw.PreferencesGroup {
                                Adw.ActionRow use_key_row {
                                    title: _("Use a key from this computer");
                                    activatable-widget: use_key_check;

                                    [prefix]
                                    CheckButton use_key_check {
                                        valign: center;
                                        active: true;
                                    }
                                }

                                Adw.ActionRow create_key_row {
                                    title: _("Create a new key");
                                    subtitle: _("The usual choice if you have never used GPG.");
                                    activatable-widget: create_key_check;

                                    [prefix]
                                    CheckButton create_key_check {
                                        valign: center;
                                        group: use_key_check;
                                    }
                                }

                                Adw.ActionRow {
                                    title: _("Import a key from a backup file");
                                    subtitle: _("A secret key saved from another computer, e.g. a .asc file.");
                                    activatable-widget: import_key_check;

                                    [prefix]
                                    CheckButton import_key_check {
                                        valign: center;
                                        group: use_key_check;
                                    }
                                }
                            }

                            Adw.PreferencesGroup existing_key_group {
                                Adw.ComboRow recipient_row {
                                    title: _("Key");
                                }
                            }

                            Adw.PreferencesGroup create_key_group {
                                description: _("GPG will then ask you to choose a passphrase. Pick one you will remember: without it, nobody can open your entries, not even you.");

                                Adw.EntryRow key_name_row {
                                    title: _("Your name");
                                }

                                Adw.EntryRow key_email_row {
                                    title: _("Email (optional)");
                                }
                            }

                            Adw.PreferencesGroup import_key_group {
                                Adw.ActionRow key_file_row {
                                    title: _("Backup file");
                                    subtitle: _("No file chosen");

                                    [suffix]
                                    Button choose_key_file_button {
                                        label: _("Choose…");
                                        valign: center;
                                    }
                                }
                            }

                            Box key_status_box {
                                spacing: 8;
                                visible: false;

                                Spinner key_spinner {
                                    valign: start;
                                }

                                Image key_status_icon {
                                    valign: start;
                                }

                                Label key_status_label {
                                    wrap: true;
                                    xalign: 0;
                                    hexpand: true;
                                }
                            }

                            Adw.PreferencesGroup backup_group {
                                Adw.ActionRow backup_row {
                                    title: _("Save a backup of this key");
                                    subtitle: _("If this computer is lost or breaks, the backup is the only way to open your entries. Keep it on a USB drive or in another safe place.");

                                    [suffix]
                                    Button backup_button {
                                        label: _("Save Backup…");
                                        valign: center;
                                    }
                                }
                            }

                            Box {
                                halign: end;
                                spacing: 12;

                                Button key_back_button {
                                    label: _("Back");
                                }

                                Button key_next_button {
                                    label: _("Next");
                                    css-classes: ["suggested-action"];
                                }
                            }
                        };
                    };
                };
            };
        }

        Adw.NavigationPage {
            tag: "sync";
            title: _("Storage");

            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    show-back-button: false;
                }

                content: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                        maximum-size: 560;
                        valign: center;
                        margin-top: 24;
                        margin-bottom: 24;
                        margin-start: 24;
                        margin-end: 24;

                        child: Box {
                            orientation: vertical;
                            spacing: 18;

                            Label sync_title {
                                label: _("Where to Keep Your Vault?");
                                wrap: true;
                                css-classes: ["title-1"];
                            }

                            Label sync_description {
                                label: _("Passel keeps an encrypted copy of your vault somewhere else: it is backed up, and you can use it from another computer or your phone.");
                                wrap: true;
                                xalign: 0;
                                css-classes: ["dim-label"];
                            }

                            Adw.PreferencesGroup {
                                Adw.ActionRow drive_row {
                                    title: _("Google Drive");
                                    subtitle: _("One file on your Google account, synced with your other computers and phones: just sign in. Passel only sees the files it makes there.");
                                    activatable-widget: drive_check;

                                    [prefix]
                                    CheckButton drive_check {
                                        valign: center;
                                        group: online_check;
                                    }
                                }

                                Adw.ActionRow online_row {
                                    title: _("Git repository");
                                    subtitle: _("A private repository on a service like GitHub, with the vault’s whole history. pass and Passel open it on your other computers and phone.");
                                    activatable-widget: online_check;

                                    [prefix]
                                    CheckButton online_check {
                                        valign: center;
                                        active: true;
                                    }

                                    [suffix]
                                    Label online_tag {
                                        label: _("Advanced · recommended");
                                        valign: center;
                                        css-classes: ["caption", "dim-label"];
                                    }
                                }

                                Adw.ActionRow folder_row {
                                    title: _("On this computer");
                                    subtitle: _("In a folder or a file you choose: a USB drive, or a folder synced by Nextcloud or Syncthing. No account needed.");
                                    activatable-widget: folder_check;

                                    [prefix]
                                    CheckButton folder_check {
                                        valign: center;
                                        group: online_check;
                                    }
                                }
                            }

                            Box {
                                halign: end;
                                spacing: 12;

                                Button sync_back_button {
                                    label: _("Back");
                                }

                                Button sync_next_button {
                                    label: _("Next");
                                    css-classes: ["suggested-action"];
                                }
                            }
                        };
                    };
                };
            };
        }

        Adw.NavigationPage {
            tag: "online";
            title: _("Git Repository");

            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    show-back-button: false;
                }

                content: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                        maximum-size: 560;
                        valign: center;
                        margin-top: 24;
                        margin-bottom: 24;
                        margin-start: 24;
                        margin-end: 24;

                        child: Box {
                            orientation: vertical;
                            spacing: 18;

                            Label {
                                label: _("Git Repository");
                                wrap: true;
                                css-classes: ["title-1"];
                            }

                            Label online_description {
                                label: _("Any of these services offers free private repositories. If you have no account yet, pick one and create it on the service’s website.");
                                wrap: true;
                                xalign: 0;
                                css-classes: ["dim-label"];
                            }

                            Box {
                                spacing: 12;
                                css-classes: ["card"];

                                Image {
                                    icon-name: "dialog-warning-symbolic";
                                    valign: start;
                                    margin-top: 12;
                                    margin-start: 12;
                                }

                                Label {
                                    label: _("Entries are encrypted, but their names (like “Bank/mybank”) are not. Always keep the repository private.");
                                    wrap: true;
                                    xalign: 0;
                                    hexpand: true;
                                    margin-top: 12;
                                    margin-bottom: 12;
                                    margin-end: 12;
                                }
                            }

                            Adw.PreferencesGroup host_group {
                                Adw.ComboRow host_row {
                                    title: _("Service");
                                }
                            }

                            Adw.PreferencesGroup host_steps_group {
                                title: _("Create an Empty Private Repository");
                            }

                            Adw.PreferencesGroup address_group {
                                title: _("Repository Address");

                                Adw.EntryRow address_row {
                                    title: _("SSH address");

                                    [suffix]
                                    Button check_button {
                                        label: _("Check");
                                        valign: center;
                                    }
                                }
                            }

                            Box check_box {
                                spacing: 8;
                                visible: false;

                                Spinner check_spinner {
                                    valign: start;
                                }

                                Image check_icon {
                                    valign: start;
                                }

                                Label check_label {
                                    wrap: true;
                                    xalign: 0;
                                    hexpand: true;
                                }
                            }

                            Box {
                                halign: end;
                                spacing: 12;

                                Button online_back_button {
                                    label: _("Back");
                                }

                                Button online_next_button {
                                    label: _("Next");
                                    css-classes: ["suggested-action"];
                                }
                            }
                        };
                    };
                };
            };
        }

        Adw.NavigationPage {
            tag: "folder";
            title: _("On This Computer");

            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    show-back-button: false;
                }

                content: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                        maximum-size: 560;
                        valign: center;
                        margin-top: 24;
                        margin-bottom: 24;
                        margin-start: 24;
                        margin-end: 24;

                        child: Box {
                            orientation: vertical;
                            spacing: 18;

                            Label {
                                label: _("On This Computer");
                                wrap: true;
                                css-classes: ["title-1"];
                            }

                            Label folder_description {
                                label: _("Passel creates an encrypted copy in the folder you choose, and keeps it up to date as you save changes.");
                                wrap: true;
                                xalign: 0;
                                css-classes: ["dim-label"];
                            }

                            Adw.PreferencesGroup {
                                Adw.ActionRow git_folder_row {
                                    title: _("A git folder");
                                    subtitle: _("“passwords.git”: git, pass and Passel on another computer use it as it is.");
                                    activatable-widget: git_folder_check;

                                    [prefix]
                                    CheckButton git_folder_check {
                                        valign: center;
                                        active: true;
                                    }
                                }

                                Adw.ActionRow bundle_file_row {
                                    title: _("One file");
                                    subtitle: _("“passwords.bundle”: a single file, which a folder synced by Nextcloud or Syncthing never delivers half-written. git clone opens it.");
                                    activatable-widget: bundle_file_check;

                                    [prefix]
                                    CheckButton bundle_file_check {
                                        valign: center;
                                        group: git_folder_check;
                                    }
                                }
                            }

                            Adw.PreferencesGroup copy_group {
                                Adw.ActionRow copy_row {
                                    title: _("Folder");
                                    subtitle: _("No folder chosen");

                                    [suffix]
                                    Button choose_copy_button {
                                        label: _("Choose…");
                                        valign: center;
                                    }
                                }
                            }

                            Box {
                                halign: end;
                                spacing: 12;

                                Button folder_back_button {
                                    label: _("Back");
                                }

                                Button folder_next_button {
                                    label: _("Next");
                                    css-classes: ["suggested-action"];
                                }
                            }
                        };
                    };
                };
            };
        }

        Adw.NavigationPage {
            tag: "drive";
            title: _("Google Drive");

            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    show-back-button: false;
                }

                content: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                        maximum-size: 560;
                        valign: center;
                        margin-top: 24;
                        margin-bottom: 24;
                        margin-start: 24;
                        margin-end: 24;

                        child: Box {
                            orientation: vertical;
                            spacing: 18;

                            Label {
                                label: _("Google Drive");
                                wrap: true;
                                css-classes: ["title-1"];
                            }

                            Label {
                                label: _("Passel keeps the vault as one file in a “Passel” folder of your Google Drive. It only sees the files it makes there.");
                                wrap: true;
                                xalign: 0;
                                css-classes: ["dim-label"];
                            }

                            Box drive_status_box {
                                spacing: 8;

                                Spinner drive_spinner {
                                    valign: center;
                                }

                                Image drive_icon {
                                    valign: center;
                                    visible: false;
                                }

                                Label drive_status_label {
                                    wrap: true;
                                    xalign: 0;
                                    hexpand: true;
                                }
                            }

                            Button drive_sign_in_button {
                                label: _("Sign In with Google");
                                halign: center;
                                visible: false;
                                css-classes: ["pill", "suggested-action"];
                            }

                            Adw.PreferencesGroup drive_vaults_group {
                                title: _("Vaults on This Google Drive");
                                visible: false;
                            }

                            Box drive_hint_box {
                                spacing: 12;
                                visible: false;

                                Label drive_hint_label {
                                    wrap: true;
                                    xalign: 0;
                                    hexpand: true;
                                }

                                Button drive_switch_button {
                                    valign: center;
                                }
                            }

                            Box {
                                halign: end;
                                spacing: 12;

                                Button drive_back_button {
                                    label: _("Back");
                                }

                                Button drive_next_button {
                                    label: _("Next");
                                    sensitive: false;
                                    css-classes: ["suggested-action"];
                                }
                            }
                        };
                    };
                };
            };
        }

        Adw.NavigationPage review_page {
            tag: "review";
            title: _("Review");

            child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                    show-back-button: false;
                }

                content: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                        maximum-size: 560;
                        valign: center;
                        margin-top: 24;
                        margin-bottom: 24;
                        margin-start: 24;
                        margin-end: 24;

                        child: Box {
                            orientation: vertical;
                            spacing: 18;

                            Label {
                                label: _("Review");
                                css-classes: ["title-1"];
                            }

                            Label {
                                label: _("Passel will:");
                                wrap: true;
                                xalign: 0;
                                css-classes: ["dim-label"];
                            }

                            ListBox steps_list {
                                selection-mode: none;
                                css-classes: ["boxed-list"];
                            }

                            Label error_label {
                                visible: false;
                                wrap: true;
                                xalign: 0;
                                selectable: true;
                                css-classes: ["error"];
                            }

                            Box {
                                halign: end;
                                spacing: 12;

                                Button review_back_button {
                                    label: _("Back");
                                }

                                Button skip_button {
                                    label: _("Skip Sync");
                                    visible: false;
                                }

                                Button apply_button {
                                    label: _("Create Vault");
                                    css-classes: ["suggested-action"];
                                }
                            }
                        };
                    };
                };
            };
        }
    };
}
