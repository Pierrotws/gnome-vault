using Gtk 4.0;
translation-domain "passel";

// One layout for both modes. The row used to hold two sibling boxes -
// a "view" box (key label, code, progress) and an "edit" box (key and
// URL entries) - and swap which one was visible, so entering edit mode
// replaced the row wholesale and changed its height. Now every widget
// is present in both modes and only the entries' editability changes:
// the URL sits in the row permanently, masked behind the reveal toggle
// exactly like the primary password field.
template $OtpFieldRow : ListBoxRow {
    child: Box {
        orientation: vertical;
        spacing: 8;
        margin-top: 8;
        margin-bottom: 8;
        margin-start: 8;
        margin-end: 8;

        Box header_box {
            orientation: horizontal;
            spacing: 8;

            Image drag_handle {
                icon-name: "list-drag-handle-symbolic";
                tooltip-text: _("Drag to reorder");
                valign: center;
                css-classes: ["dim-label"];
            }

            Entry key_entry {
                hexpand: true;
                placeholder-text: C_("field", "Key");
                has-frame: false;
                css-classes: ["title-2", "heading", "field-entry"];
            }

            Button delete_button {
                icon-name: "user-trash-symbolic";
                tooltip-text: _("Delete field");
                valign: center;

                accessibility {
                    label: _("Delete field");
                }
            }

            Button copy_code_button {
                icon-name: "edit-copy-symbolic";
                tooltip-text: _("Copy code");
                valign: center;

                accessibility {
                    label: _("Copy code");
                }
            }
        }

        // The code and its countdown sit inset from the row's edges
        // rather than spanning the whole entry pane.
        Box code_box {
            orientation: vertical;
            spacing: 8;
            margin-start: 72;
            margin-end: 72;

            Label code_label {
                halign: center;
                xalign: 0.5;
                css-classes: ["title-1", "numeric"];
            }

            ProgressBar validity_progress {
                hexpand: true;
            }
        }

        Box url_box {
            orientation: horizontal;
            spacing: 8;

            Entry url_entry {
                hexpand: true;
                width-chars: 32;
                placeholder-text: _("otpauth://totp/...");
                visibility: false;
                has-frame: false;
                input-purpose: password;
                input-hints: private | no_emoji | no_spellcheck;
                css-classes: ["field-entry"];
            }

            ToggleButton reveal_url_button {
                icon-name: "view-reveal-symbolic";
                tooltip-text: _("Show URL");
                valign: center;

                accessibility {
                    label: _("Show URL");
                }
            }

            Button copy_url_button {
                icon-name: "edit-copy-symbolic";
                tooltip-text: _("Copy URL");
                valign: center;

                accessibility {
                    label: _("Copy URL");
                }
            }
        }
    };
}
