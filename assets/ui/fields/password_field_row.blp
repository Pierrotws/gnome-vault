using Gtk 4.0;
using Adw 1;
translation-domain "passel";

template $PasswordFieldRow : Adw.Bin {
    child: Adw.PasswordEntryRow password_entry {
        title: _("Password");

        [suffix]
        Button generate_password_button {
            icon-name: "view-refresh-symbolic";
            tooltip-text: _("Generate password");
            valign: center;
            margin-start: 6;

            accessibility {
                label: _("Generate password");
            }
        }

        [suffix]
        Button copy_password_button {
            icon-name: "edit-copy-symbolic";
            tooltip-text: _("Copy password");
            valign: center;

            accessibility {
                label: _("Copy password");
            }
        }
    };
}
