using Gtk 4.0;

template $PlainFieldRow : ListBoxRow {
    child: Box {
        orientation: horizontal;
        spacing: 8;
        margin-top: 8;
        margin-bottom: 8;
        margin-start: 8;
        margin-end: 8;

        Image drag_handle {
            icon-name: "list-drag-handle-symbolic";
            tooltip-text: _("Drag to reorder");
            valign: center;
            css-classes: ["dim-label"];
        }

        // Both entries stay frameless in read-only *and* edit mode; the
        // "field-entry" class gives them a framed entry's metrics so the
        // row keeps its height and its columns keep their x positions
        // when the mode changes.
        //
        // The key column sizes to its text rather than to a fixed
        // character count (see PlainFieldRow::sync_key_width), and the
        // entry view puts every key entry in one horizontal SizeGroup so
        // the column is as wide as its longest key and the separators
        // stay aligned. The key is left-aligned, and styled like the
        // value, only bold.
        Entry key_entry {
            hexpand: false;
            width-chars: 1;
            max-width-chars: 24;
            xalign: 0;
            placeholder-text: _("Key");
            has-frame: false;
            css-classes: ["field-entry", "field-key"];
        }

        Separator key_value_separator {
            orientation: vertical;
        }

        // A small minimum: when the pane narrows, the value gives up
        // room before the key column does.
        Entry value_entry {
            hexpand: true;
            width-chars: 8;
            placeholder-text: _("Value");
            has-frame: false;
            css-classes: ["field-entry"];
        }

        Button delete_button {
            icon-name: "user-trash-symbolic";
            tooltip-text: _("Delete field");
            valign: center;

            accessibility {
                label: _("Delete field");
            }
        }

        Button copy_button {
            icon-name: "edit-copy-symbolic";
            tooltip-text: _("Copy value");
            valign: center;

            accessibility {
                label: _("Copy value");
            }
        }
    };
}
