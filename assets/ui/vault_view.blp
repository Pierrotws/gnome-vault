using Gtk 4.0;
translation-domain "passel";

template $VaultView : Gtk.Box {
    orientation: vertical;
    spacing: 8;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;
    // No width-request: the window's tree column sets the minimum.

    SearchEntry search_entry {
        placeholder-text: _("Search entries and groups");
        // GtkText's default minimum (~150px of text) would otherwise
        // set the tree column's minimum width on its own.
        width-chars: 4;
    }

    ScrolledWindow {
        vexpand: true;
        hexpand: true;

        child: ListView tree_view {
            single-click-activate: false;
            css-classes: ["vault-tree"];
        };
    }
}
