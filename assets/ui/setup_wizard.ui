                                <child>
                                  <object class="AdwActionRow" id="copy_row">
                                    <property name="title" translatable="yes">Folder</property>
                                    <property name="subtitle" translatable="yes">No folder chosen</property>
                                    <child type="suffix">
                                      <object class="GtkButton" id="choose_copy_button">
                                        <property name="label" translatable="yes">Choose…</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">2</property>
                                <property name="spacing">12</property>
                                <child>
                                  <object class="GtkButton" id="folder_back_button">
                                    <property name="label" translatable="yes">Back</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="folder_next_button">
                                    <property name="label" translatable="yes">Next</property>
                                    <property name="css-classes">suggested-action</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwNavigationPage">
            <property name="tag">drive</property>
            <property name="title" translatable="yes">Google Drive</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-back-button">false</property>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">2</property>
                    <property name="child">
                      <object class="AdwClamp">
                        <property name="maximum-size">560</property>
                        <property name="valign">3</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <property name="spacing">18</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Google Drive</property>
                                <property name="wrap">true</property>
                                <property name="css-classes">title-1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Passel keeps the vault as one file in a “Passel” folder of your Google Drive. It only sees the files it makes there.</property>
                                <property name="wrap">true</property>
                                <property name="xalign">0</property>
                                <property name="css-classes">dim-label</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="drive_status_box">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkSpinner" id="drive_spinner">
                                    <property name="valign">3</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage" id="drive_icon">
                                    <property name="valign">3</property>
                                    <property name="visible">false</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="drive_status_label">
                                    <property name="wrap">true</property>
                                    <property name="xalign">0</property>
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="drive_sign_in_button">
                                <property name="label" translatable="yes">Sign In with Google</property>
                                <property name="halign">3</property>
                                <property name="visible">false</property>
                                <property name="css-classes">pill
suggested-action</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="drive_vaults_group">
                                <property name="title" translatable="yes">Vaults on This Google Drive</property>
                                <property name="visible">false</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="drive_hint_box">
                                <property name="spacing">12</property>
                                <property name="visible">false</property>
                                <child>
                                  <object class="GtkLabel" id="drive_hint_label">
                                    <property name="wrap">true</property>
                                    <property name="xalign">0</property>
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="drive_switch_button">
                                    <property name="valign">3</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">2</property>
                                <property name="spacing">12</property>
                                <child>
                                  <object class="GtkButton" id="drive_back_button">
                                    <property name="label" translatable="yes">Back</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="drive_next_button">
                                    <property name="label" translatable="yes">Next</property>
                                    <property name="sensitive">false</property>
                                    <property name="css-classes">suggested-action</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwNavigationPage" id="review_page">
            <property name="tag">review</property>
            <property name="title" translatable="yes">Review</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-back-button">false</property>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">2</property>
                    <property name="child">
                      <object class="AdwClamp">
                        <property name="maximum-size">560</property>
                        <property name="valign">3</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <property name="spacing">18</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Review</property>
                                <property name="css-classes">title-1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Passel will:</property>
                                <property name="wrap">true</property>
                                <property name="xalign">0</property>
                                <property name="css-classes">dim-label</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox" id="steps_list">
                                <property name="selection-mode">0</property>
                                <property name="css-classes">boxed-list</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="error_label">
                                <property name="visible">false</property>
                                <property name="wrap">true</property>
                                <property name="xalign">0</property>
                                <property name="selectable">true</property>
                                <property name="css-classes">error</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">2</property>
                                <property name="spacing">12</property>
                                <child>
                                  <object class="GtkButton" id="review_back_button">
                                    <property name="label" translatable="yes">Back</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="skip_button">
                                    <property name="label" translatable="yes">Skip Sync</property>
                                    <property name="visible">false</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="apply_button">
                                    <property name="label" translatable="yes">Create Vault</property>
                                    <property name="css-classes">suggested-action</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>