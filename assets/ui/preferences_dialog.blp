using Gtk 4.0;
using Adw 1;
translation-domain "passel";

Adw.PreferencesDialog preferences_dialog {
    title: _("Preferences");

    Adw.PreferencesPage {
        Adw.PreferencesGroup {
            title: _("App");

            Adw.SwitchRow autoload_row {
                title: _("Load entries at startup");
                subtitle: _("Decrypt entries in the background so search includes custom field values");
            }

            Adw.SwitchRow show_group_view_row {
                title: _("Show group view");
                subtitle: _("Use a group-only tree with a separate entries pane");
            }

            Adw.SwitchRow interpret_multiline_as_markdown_row {
                title: _("Interpret multiline as markdown");
                subtitle: _("Render multiline fields as Markdown in read-only mode");
            }

            Adw.ComboRow tree_view_size_row {
                title: _("Tree view size");
                subtitle: _("Visual density of vault tree rows");
                model: Gtk.StringList {
                    strings [_("Small"), _("Medium"), _("Large")]
                };
            }
        }
    }
}
