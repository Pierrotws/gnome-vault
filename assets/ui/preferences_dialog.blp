using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog preferences_dialog {
    title: "Preferences";

    Adw.PreferencesPage {
        Adw.PreferencesGroup {
            title: "App";

            Adw.SwitchRow autoload_row {
                title: "Load entries at startup";
                subtitle: "Decrypt entries in the background so search includes custom field values";
            }

            Adw.SwitchRow show_group_view_row {
                title: "Show group view";
                subtitle: "Use a group-only tree with a separate entries pane";
            }

            Adw.SwitchRow interpret_multiline_as_markdown_row {
                title: "Interpret multiline as markdown";
                subtitle: "Render multiline fields as Markdown in read-only mode";
            }
        }
        Adw.PreferencesGroup {
            title: "Git";

            Adw.EntryRow store_dir_row {
                title: "Vault directory";
                show-apply-button: true;
            }

            Adw.EntryRow branch_row {
                title: "Branch";
                show-apply-button: true;
            }

            Adw.SwitchRow autopush_row {
                title: "Push changes automatically";
                subtitle: "Push to the remote after every saved change";
            }
        }
    }
}
