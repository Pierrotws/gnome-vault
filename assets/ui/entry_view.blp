using Gtk 4.0;
using Adw 1;

template $EntryView : Adw.Bin {
    child: Stack content_stack {
        vexpand: true;

        StackPage {
            name: "empty";
            child: Box {
                vexpand: true;
                valign: center;
                halign: center;
                orientation: vertical;
                spacing: 12;

                Label {
                    label: "No entry selected";
                    css-classes: ["title-3"];
                }

                Label {
                    label: "Select an item from the tree";
                    css-classes: ["dim-label"];
                }
            };
        }

        StackPage {
            name: "content";
            child: Box {
                vexpand: true;
                hexpand: true;
                orientation: vertical;
                spacing: 10;
                margin-top: 18;
                margin-bottom: 18;
                margin-start: 18;
                margin-end: 18;

                // Read-only by default: Edit opens edit mode, which
                // Cancel or Save close (the GNOME Contacts pattern). A
                // stack keeps the row's size between the two.
                Stack edit_actions_stack {
                    halign: end;
                    hhomogeneous: false;

                    StackPage {
                        name: "view";
                        child: Button edit_button {
                            halign: end;
                            tooltip-text: "Edit this entry";

                            child: Adw.ButtonContent {
                                icon-name: "document-edit-symbolic";
                                label: "_Edit";
                                use-underline: true;
                            };
                        };
                    }

                    StackPage {
                        name: "edit";
                        child: Box {
                            orientation: horizontal;
                            spacing: 12;
                            halign: end;

                            Button cancel_button {
                                label: "_Cancel";
                                use-underline: true;
                            }

                            Button save_button {
                                label: "_Save";
                                use-underline: true;
                                css-classes: [ "suggested-action"];
                            }
                        };
                    }
                }

                // One widget for both modes: a frameless entry that is
                // simply not editable outside edit mode. The previous
                // Label/Entry pair had to be swapped on every mode
                // change, and the two never lined up to the pixel.
                Entry title_entry {
                    placeholder-text: "Entry name";
                    halign: center;
                    xalign: 0.5;
                    hexpand: false;
                    width-chars: 1;
                    max-width-chars: 48;
                    has-frame: false;
                    css-classes: [ "title-1", "heading", "field-entry"];
                }

                Stack primary_field_stack {
                    vexpand: false;
                    // Without this the stack reserves the taller page's
                    // height for both, leaving a dead band under the
                    // password row on every non-OTP entry.
                    vhomogeneous: false;

                    StackPage {
                        name: "password";
                        child: $PasswordFieldRow password_field_row {};
                    }

                    StackPage {
                        name: "otp";
                        child: $OtpFieldRow primary_otp_field_row {};
                    }
                }

                ScrolledWindow custom_fields_scrolled_window {
                    // Vertical scrolling only. Scrolling sideways hid the
                    // field rows' minimum width from the window, so a
                    // narrow pane clipped the rows' trailing buttons
                    // instead of stopping the pane handle.
                    hscrollbar-policy: never;
                    min-content-height: 0;
                    propagate-natural-height: false;
                    vexpand: true;
                    hexpand: true;

                    child: Box {
                        orientation: vertical;
                        valign: start;
                        vexpand: false;
                        hexpand: true;

                        Box custom_fields_list {
                            orientation: vertical;
                            spacing: 8;
                            valign: start;
                            vexpand: false;
                            hexpand: true;

                            Box add_field_row {
                                orientation: horizontal;
                                spacing: 8;
                                vexpand: false;
                                hexpand: true;

                                MenuButton add_field_menu_button {
                                    icon-name: "list-add-symbolic";
                                    tooltip-text: "Add field";
                                    valign: center;

                                    popover: Popover {
                                        child: Box {
                                            orientation: vertical;
                                            spacing: 6;
                                            margin-top: 6;
                                            margin-bottom: 6;
                                            margin-start: 6;
                                            margin-end: 6;

                                            Button add_plain_field_button {
                                                label: "Plain";
                                                halign: fill;
                                            }

                                            Button add_otp_field_button {
                                                label: "OTP";
                                                halign: fill;
                                            }

                                            Button add_multiline_field_button {
                                                label: "Multiline";
                                                halign: fill;
                                            }
                                        };
                                    };
                                }
                            }

                            Box {
                                vexpand: true;
                            }
                        }
                    };
                }

                Box footer_actions {
                    orientation: horizontal;
                    spacing: 12;
                    vexpand: false;
                    hexpand: true;

                    Box {
                        orientation: horizontal;
                        spacing: 12;
                        halign: start;
                        hexpand: true;

                        Button delete_button {
                            label: "Delete Entry";
                            css-classes: [ "destructive-action"];
                        }
                    }
                }
            };
        }
    };
}
