using Gtk 4.0;
using Adw 1;
translation-domain "passel";

Adw.Window new_entry_dialog {
    title: _("New Entry");
    modal: true;
    resizable: true;
    default-width: 640;
    default-height: 520;

    content: Gtk.Box {
        orientation: vertical;

        Gtk.Box {
            orientation: vertical;
            spacing: 18;
            margin-top: 18;
            margin-start: 18;
            margin-end: 18;

            Adw.PreferencesGroup {
                title: _("Entry");

                Adw.EntryRow name_row {
                    title: _("Name");
                }

                Adw.EntryRow folder_row {
                    title: _("Parent Folder");
                }
            }

            $GeneratePasswordView generator {}
        }

        Gtk.Box {
            orientation: horizontal;
            spacing: 12;
            halign: end;
            margin-top: 18;
            margin-bottom: 18;
            margin-start: 18;
            margin-end: 18;

            Gtk.Button cancel_button {
                label: _("Cancel");
            }

            Gtk.Button create_button {
                label: _("Create");
                sensitive: false;
                styles ["suggested-action"]
            }
        }
    };
}
