using Gtk 4.0;
using Adw 1;
translation-domain "passel";

template $MainWindow : Adw.ApplicationWindow {
    title: _("Vault");
    default-width: 1080;
    default-height: 720;

    content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            title-widget: MenuButton vault_menu_button {
                tooltip-text: _("Vaults");
                css-classes: ["flat"];

                popover: Popover vault_popover {
                    child: Box {
                        orientation: vertical;
                        spacing: 6;
                        width-request: 360;

                        ListBox vault_list {
                            selection-mode: none;
                            css-classes: ["boxed-list"];
                        }

                        Separator {}

                        Button new_vault_button {
                            css-classes: ["flat"];

                            child: Label {
                                label: _("New Vault…");
                                xalign: 0;
                            };
                        }

                        Button add_vault_button {
                            css-classes: ["flat"];

                            child: Label {
                                label: _("Add Existing Folder…");
                                xalign: 0;
                            };
                        }

                        Button import_button {
                            css-classes: ["flat"];
                            tooltip-text: _("Import entries from KeePassXC or Buttercup into this vault");

                            child: Label {
                                label: _("Import Passwords…");
                                xalign: 0;
                            };
                        }
                    };
                };

                child: Box {
                    spacing: 6;

                    Adw.WindowTitle window_title {
                        title: "Passel";
                    }

                    Image {
                        icon-name: "pan-down-symbolic";
                    }
                };
            };

            [start]
            Button new_entry_button {
                icon-name: "list-add-symbolic";
                tooltip-text: _("New Entry");
            }

            [end]
            Button preferences_button {
                icon-name: "emblem-system-symbolic";
                tooltip-text: _("Preferences");
            }
        }

        content: Stack main_stack {
            StackPage {
                name: "setup";
                child: Adw.StatusPage no_vault_page {
                    icon-name: "dialog-password-symbolic";
                    title: _("No Vault Yet");
                    description: _("A vault is an encrypted folder that holds your passwords.");

                    child: Box {
                        orientation: vertical;
                        spacing: 12;
                        halign: center;

                        Button create_vault_button {
                            label: _("Create a Vault");
                            css-classes: ["suggested-action", "pill"];
                        }

                        Button open_existing_vault_button {
                            label: _("Open an Existing Folder…");
                            css-classes: ["pill"];
                        }
                    };
                };
            }

            StackPage {
                name: "enable-history";
                child: Adw.StatusPage enable_history_page {
                    icon-name: "document-open-recent-symbolic";
                    title: _("Turn On History");

                    child: Box {
                        orientation: vertical;
                        spacing: 12;
                        halign: center;

                        Button enable_history_button {
                            label: _("Turn On History");
                            css-classes: ["suggested-action", "pill"];
                        }

                        Button decline_history_button {
                            label: _("Not Now");
                            tooltip-text: _("Open this vault without history. You can turn it on later in the vault’s settings.");
                            css-classes: ["pill"];
                        }
                    };
                };
            }

            StackPage {
                name: "missing";
                child: Adw.StatusPage missing_vault_page {
                    icon-name: "folder-open-symbolic";
                    title: _("Vault Not Found");

                    child: Button remove_missing_vault_button {
                        label: _("Remove from List");
                        halign: center;
                        css-classes: ["pill"];
                    };
                };
            }

            StackPage {
                name: "app";
                child: Paned main_paned {
                    orientation: horizontal;
                    wide-handle: true;
                    position: 360;
                    // Neither pane may shrink below its children's
                    // minimum widths, so no column can be dragged (or
                    // window-resized) down to nothing. GtkPaned clamps
                    // the handle itself from those minimums.
                    shrink-start-child: false;
                    shrink-end-child: false;

                    start-child: Box selection_zone {
                        orientation: vertical;

                        Stack selection_stack {
                            vexpand: true;
                            hexpand: true;
                            // Size to the visible page only: the tree-only
                            // layout must not inherit the split layout's
                            // (two-column) minimum width.
                            hhomogeneous: false;

                            StackPage {
                                name: "tree";
                                child: Adw.Bin simple_vault_bin {
                                    vexpand: true;
                                    hexpand: true;
                                    width-request: 120;
                                    child: $VaultView vault_view {};
                                };
                            }

                            StackPage {
                                name: "group";
                                child: Paned selection_paned {
                                    vexpand: true;
                                    hexpand: true;
                                    orientation: horizontal;
                                    wide-handle: true;
                                    position: 170;
                                    // The tree keeps its width when the
                                    // selection area is resized; the
                                    // entries list takes the difference.
                                    resize-start-child: false;
                                    resize-end-child: true;
                                    shrink-start-child: false;
                                    shrink-end-child: false;

                                    start-child: Adw.Bin group_vault_bin {
                                        vexpand: true;
                                        width-request: 120;
                                    };

                                    end-child: $GroupView group_view {
                                        vexpand: true;
                                        hexpand: true;
                                        width-request: 120;
                                    };
                                };
                            }
                        }

                        // Hidden when the open vault has no history:
                        // there is nothing to show in Changes.
                        Box changes_area {
                            orientation: vertical;

                            Separator {
                                orientation: horizontal;
                            }

                            Box {
                                orientation: vertical;
                                margin-top: 8;
                                margin-bottom: 8;
                                margin-start: 8;
                                margin-end: 8;

                                Button changes_button {
                                    halign: fill;
                                    css-classes: ["flat"];

                                    child: Box {
                                        orientation: horizontal;
                                        spacing: 8;
                                        halign: center;
                                        margin-top: 6;
                                        margin-bottom: 6;

                                        Image {
                                            icon-name: "view-list-symbolic";
                                        }

                                        Label {
                                            label: _("Changes");
                                        }

                                        Label changes_badge {
                                            css-classes: ["changes-badge"];
                                            visible: false;
                                        }
                                    };
                                }
                            }
                        }
                    };

                    end-child: Stack content_stack {
                        vexpand: true;
                        hexpand: true;

                        StackPage {
                            name: "empty";
                            child: Box {
                                orientation: vertical;
                                halign: center;
                                valign: center;
                                spacing: 8;
                                margin-top: 24;
                                margin-bottom: 24;
                                margin-start: 24;
                                margin-end: 24;

                                Label {
                                    label: _("No entry selected");
                                    css-classes: ["title-3"];
                                }

                                Label {
                                    label: _("Select an entry");
                                    css-classes: ["dim-label"];
                                }
                            };
                        }

                        StackPage {
                            name: "entry";
                            child: Adw.Bin entry_bin {
                                child: $EntryView entry_view {};
                            };
                        }

                        StackPage {
                            name: "changes";
                            child: $ChangesView changes_view {};
                        }
                    };
                };
            }
        };
    };
}
