using Gtk 4.0;
using Adw 1;

template $MainWindow : Adw.ApplicationWindow {
    title: "Vault";
    default-width: 1080;
    default-height: 720;

    content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            title-widget: Adw.WindowTitle window_title {
                title: "Passel";
                subtitle: "Read-only";
            };

            [start]
            Button new_entry_button {
                icon-name: "list-add-symbolic";
                tooltip-text: "New Entry";
            }

            [end]
            Button preferences_button {
                icon-name: "emblem-system-symbolic";
                tooltip-text: "Preferences";
            }

            [end]
            Button lock_vault_button {
                icon-name: "system-lock-screen-symbolic";
                tooltip-text: "Unlock editing";
            }
        }

        content: Stack main_stack {
            StackPage {
                name: "setup";
                child: Adw.StatusPage no_vault_page {
                    icon-name: "dialog-password-symbolic";
                    title: "No Vault Yet";
                    description: "A vault is an encrypted folder that holds your passwords.";

                    child: Button create_vault_button {
                        label: "Create a Vault";
                        halign: center;
                        css-classes: ["suggested-action", "pill"];
                    };
                };
            }

            StackPage {
                name: "enable-history";
                child: Adw.StatusPage enable_history_page {
                    icon-name: "document-open-recent-symbolic";
                    title: "Turn On History";

                    child: Button enable_history_button {
                        label: "Turn On History";
                        halign: center;
                        css-classes: ["suggested-action", "pill"];
                    };
                };
            }

            StackPage {
                name: "app";
                child: Paned main_paned {
                    orientation: horizontal;
                    wide-handle: true;
                    position: 360;
                    // Neither pane may shrink below its children's
                    // minimum widths, so no column can be dragged (or
                    // window-resized) down to nothing. GtkPaned clamps
                    // the handle itself from those minimums.
                    shrink-start-child: false;
                    shrink-end-child: false;

                    start-child: Box selection_zone {
                        orientation: vertical;

                        Stack selection_stack {
                            vexpand: true;
                            hexpand: true;
                            // Size to the visible page only: the tree-only
                            // layout must not inherit the split layout's
                            // (two-column) minimum width.
                            hhomogeneous: false;

                            StackPage {
                                name: "tree";
                                child: Adw.Bin simple_vault_bin {
                                    vexpand: true;
                                    hexpand: true;
                                    width-request: 120;
                                    child: $VaultView vault_view {};
                                };
                            }

                            StackPage {
                                name: "group";
                                child: Paned selection_paned {
                                    vexpand: true;
                                    hexpand: true;
                                    orientation: horizontal;
                                    wide-handle: true;
                                    position: 170;
                                    // The tree keeps its width when the
                                    // selection area is resized; the
                                    // entries list takes the difference.
                                    resize-start-child: false;
                                    resize-end-child: true;
                                    shrink-start-child: false;
                                    shrink-end-child: false;

                                    start-child: Adw.Bin group_vault_bin {
                                        vexpand: true;
                                        width-request: 120;
                                    };

                                    end-child: $GroupView group_view {
                                        vexpand: true;
                                        hexpand: true;
                                        width-request: 120;
                                    };
                                };
                            }
                        }

                        Separator {
                            orientation: horizontal;
                        }

                        Box {
                            orientation: vertical;
                            margin-top: 8;
                            margin-bottom: 8;
                            margin-start: 8;
                            margin-end: 8;

                            Button changes_button {
                                halign: fill;
                                css-classes: ["flat"];

                                child: Box {
                                    orientation: horizontal;
                                    spacing: 8;
                                    halign: center;
                                    margin-top: 6;
                                    margin-bottom: 6;

                                    Image {
                                        icon-name: "view-list-symbolic";
                                    }

                                    Label {
                                        label: "Changes";
                                    }

                                    Label changes_badge {
                                        css-classes: ["changes-badge"];
                                        visible: false;
                                    }
                                };
                            }
                        }
                    };

                    end-child: Stack content_stack {
                        vexpand: true;
                        hexpand: true;

                        StackPage {
                            name: "empty";
                            child: Box {
                                orientation: vertical;
                                halign: center;
                                valign: center;
                                spacing: 8;
                                margin-top: 24;
                                margin-bottom: 24;
                                margin-start: 24;
                                margin-end: 24;

                                Label {
                                    label: "No entry selected";
                                    css-classes: ["title-3"];
                                }

                                Label {
                                    label: "Select an entry";
                                    css-classes: ["dim-label"];
                                }
                            };
                        }

                        StackPage {
                            name: "entry";
                            child: Adw.Bin entry_bin {
                                child: $EntryView entry_view {};
                            };
                        }

                        StackPage {
                            name: "changes";
                            child: $ChangesView changes_view {};
                        }
                    };
                };
            }
        };
    };
}
