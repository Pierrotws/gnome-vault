using Gtk 4.0;
using Adw 1;

template $MainWindow : Adw.ApplicationWindow {
    title: "Vault";
    default-width: 1200;
    default-height: 720;

    content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            title-widget: Adw.WindowTitle window_title {
                title: "Gnome Vault";
                subtitle: "Read-only";
            };

            [start]
            Button new_entry_button {
                icon-name: "list-add-symbolic";
                tooltip-text: "New Entry";
            }

            [end]
            Button preferences_button {
                icon-name: "emblem-system-symbolic";
                tooltip-text: "Preferences";
            }

            [end]
            Button lock_vault_button {
                icon-name: "system-lock-screen-symbolic";
                tooltip-text: "Unlock editing";
            }
        }

        content: Stack main_stack {
            StackPage {
                name: "setup";
                child: Box {
                    orientation: vertical;
                    halign: center;
                    valign: center;
                    width-request: 560;
                    spacing: 18;
                    margin-top: 24;
                    margin-bottom: 24;
                    margin-start: 24;
                    margin-end: 24;

                    Label {
                        label: "Create a Vault";
                        css-classes: ["title-1"];
                    }

                    Label {
                        label: "Choose where to store encrypted entries, configure your GPG recipient, and optionally connect a remote.";
                        wrap: true;
                        xalign: 0;
                        css-classes: ["dim-label"];
                    }

                    Adw.PreferencesGroup {
                        title: "Vault";

                        Adw.EntryRow setup_path_row {
                            title: "Folder";
                        }

                        Adw.ComboRow setup_recipient_row {
                            title: "Signature Key (GPG)";
                        }
                    }

                    Adw.PreferencesGroup {
                        title: "Sync";

                        Adw.ComboRow setup_provider_row {
                            title: "Provider";
                        }

                        Adw.EntryRow setup_remote_row {
                            title: "Remote URL";
                            sensitive: false;
                        }
                    }

                    Box {
                        orientation: horizontal;
                        halign: end;
                        spacing: 12;

                        Button create_vault_button {
                            label: "Create Vault";
                            css-classes: ["suggested-action"];
                        }
                    }
                };
            }

            StackPage {
                name: "app";
                child: Paned main_paned {
                    orientation: horizontal;
                    wide-handle: true;
                    position: 260;
                    shrink-start-child: true;
                    shrink-end-child: false;

                    start-child: Box selection_zone {
                        orientation: vertical;
                        width-request: 200;

                        Stack selection_stack {
                            vexpand: true;

                            StackPage {
                                name: "tree";
                                child: Adw.Bin simple_vault_bin {
                                    child: $VaultView vault_view {};
                                };
                            }

                            StackPage {
                                name: "group";
                                child: Paned selection_paned {
                                    orientation: horizontal;
                                    wide-handle: true;
                                    position: 200;
                                    shrink-start-child: false;
                                    shrink-end-child: true;

                                    start-child: Adw.Bin group_vault_bin {
                                        width-request: 200;
                                    };

                                    end-child: $GroupView group_view {
                                        width-request: 280;
                                    };
                                };
                            }
                        }

                        Separator {
                            orientation: horizontal;
                        }

                        Box {
                            orientation: vertical;
                            margin-top: 8;
                            margin-bottom: 8;
                            margin-start: 8;
                            margin-end: 8;

                            Button changes_button {
                                halign: fill;
                                css-classes: ["flat"];

                                child: Adw.ButtonContent {
                                    icon-name: "view-list-symbolic";
                                    label: "Changes";
                                };
                            }
                        }
                    };

                    end-child: Stack content_stack {
                        vexpand: true;
                        hexpand: true;

                        StackPage {
                            name: "empty";
                            child: Box {
                                orientation: vertical;
                                halign: center;
                                valign: center;
                                spacing: 8;
                                margin-top: 24;
                                margin-bottom: 24;
                                margin-start: 24;
                                margin-end: 24;

                                Label {
                                    label: "No entry selected";
                                    css-classes: ["title-3"];
                                }

                                Label {
                                    label: "Select an entry";
                                    css-classes: ["dim-label"];
                                }
                            };
                        }

                        StackPage {
                            name: "entry";
                            child: Adw.Bin entry_bin {
                                child: $EntryView entry_view {};
                            };
                        }

                        StackPage {
                            name: "changes";
                            child: $ChangesView changes_view {};
                        }
                    };
                };
            }
        };
    };
}
