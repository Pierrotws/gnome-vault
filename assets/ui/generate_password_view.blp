using Gtk 4.0;
using Adw 1;
translation-domain "passel";

template $GeneratePasswordView : Adw.Bin {
    child: Box {
        orientation: vertical;
        spacing: 18;
        margin-top: 18;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        Adw.PreferencesGroup {
            title: _("Options");

            Adw.ActionRow {
                title: _("Length");

                [suffix]
                SpinButton length_spin {
                    adjustment: Adjustment {
                        lower: 4;
                        upper: 256;
                        step-increment: 1;
                        page-increment: 8;
                        value: 16;
                    };
                    digits: 0;
                    numeric: true;
                    valign: center;
                    width-chars: 4;
                }
            }

            Adw.ComboRow charset_row {
                title: _("Character Set");
            }
        }

        Adw.PreferencesGroup {
            title: _("Preview");

            Adw.PasswordEntryRow preview_password_row {
                title: _("Generated Password");
                show-apply-button: false;

                [suffix]
                Button reload_button {
                    icon-name: "view-refresh-symbolic";
                    tooltip-text: _("Generate another password");
                    valign: center;
                }
            }
        }
    };
}
