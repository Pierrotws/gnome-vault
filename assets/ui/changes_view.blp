using Gtk 4.0;

template $ChangesView : Gtk.Box {
    orientation: vertical;
    spacing: 8;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;
    hexpand: true;

    Label {
        label: "Changes";
        xalign: 0;
        css-classes: ["heading"];
    }

    Label empty_label {
        label: "No changes";
        xalign: 0;
        css-classes: ["dim-label"];
    }

    ScrolledWindow changes_scrolled_window {
        vexpand: true;
        hexpand: true;

        child: ListView changes_list {
            single-click-activate: false;
            show-separators: true;
            css-classes: ["navigation-sidebar"];
        };
    }
}
