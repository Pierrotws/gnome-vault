using Gtk 4.0;
using Adw 1;

template $EntryView : Adw.Bin {
    child: Stack content_stack {
        vexpand: true;

        StackPage {
            name: "empty";
            child: Box {
                vexpand: true;
                valign: center;
                halign: center;
                orientation: vertical;
                spacing: 12;

                Label {
                    label: "No entry selected";
                    css-classes: ["title-3"];
                }

                Label {
                    label: "Select an item from the tree";
                    css-classes: ["dim-label"];
                }
            };
        }

        StackPage {
            name: "content";
            child: Box {
                vexpand: true;
                hexpand: true;
                orientation: vertical;
                spacing: 10;
                margin-top: 18;
                margin-bottom: 18;
                margin-start: 18;
                margin-end: 18;

                Label title_label {
                    label: "";
                    xalign: 0;
                    halign: center;
                    css-classes: [ "title-2"];
                }

                Stack primary_field_stack {
                    vexpand: false;

                    StackPage {
                        name: "password";
                        child: $PasswordFieldRow password_field_row {};
                    }

                    StackPage {
                        name: "otp";
                        child: $OtpFieldRow primary_otp_field_row {};
                    }
                }

                ScrolledWindow custom_fields_scrolled_window {
                    min-content-height: 0;
                    propagate-natural-height: false;
                    vexpand: true;
                    hexpand: true;

                    child: Box {
                        orientation: vertical;
                        valign: start;
                        vexpand: false;
                        hexpand: true;

                        Box custom_fields_list {
                            orientation: vertical;
                            spacing: 8;
                            valign: start;
                            vexpand: false;
                            hexpand: true;

                            Box add_field_row {
                                orientation: horizontal;
                                spacing: 8;
                                vexpand: false;
                                hexpand: true;

                                MenuButton add_field_menu_button {
                                    icon-name: "list-add-symbolic";
                                    tooltip-text: "Add field";
                                    valign: center;

                                    popover: Popover {
                                        child: Box {
                                            orientation: vertical;
                                            spacing: 6;
                                            margin-top: 6;
                                            margin-bottom: 6;
                                            margin-start: 6;
                                            margin-end: 6;

                                            Button add_plain_field_button {
                                                label: "Plain";
                                                halign: fill;
                                            }

                                            Button add_otp_field_button {
                                                label: "OTP";
                                                halign: fill;
                                            }

                                            Button add_array_field_button {
                                                label: "Array";
                                                halign: fill;
                                            }

                                            Button add_multiline_field_button {
                                                label: "Multiline";
                                                halign: fill;
                                            }
                                        };
                                    };
                                }
                            }

                            Box {
                                vexpand: true;
                            }
                        }
                    };
                }

                Box footer_actions {
                    orientation: horizontal;
                    spacing: 12;
                    vexpand: false;
                    hexpand: true;

                    Box {
                        orientation: horizontal;
                        spacing: 12;
                        halign: start;
                        hexpand: true;

                        Button delete_button {
                            label: "Delete Entry";
                            css-classes: [ "destructive-action"];
                        }
                    }

                    Box {
                        orientation: horizontal;
                        spacing: 12;
                        halign: end;

                        Button cancel_button {
                            label: "Cancel";
                        }

                        Button save_button {
                            label: "Save";
                            css-classes: [ "suggested-action"];
                        }
                    }
                }
            };
        }
    };
}
