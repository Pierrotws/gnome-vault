using Gtk 4.0;
using Adw 1;

template $MainWindow : Adw.ApplicationWindow {
    title: "Vault";
    default-width: 1200;
    default-height: 720;

    content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            title-widget: Adw.WindowTitle window_title {
                title: "Gnome Vault";
                subtitle: "Read-only";
            };

            [start]
            Button new_entry_button {
                icon-name: "list-add-symbolic";
                tooltip-text: "New Entry";
            }

            [end]
            Button preferences_button {
                icon-name: "emblem-system-symbolic";
                tooltip-text: "Preferences";
            }

            [end]
            Button lock_vault_button {
                icon-name: "system-lock-screen-symbolic";
                tooltip-text: "Unlock editing";
            }
        }

        content: Paned {
            orientation: horizontal;
            wide-handle: true;
            position: 400;
            shrink-start-child: false;
            shrink-end-child: false;

            start-child: Box {
                orientation: vertical;
                width-request: 360;

                StackSwitcher {
                    stack: navigation_stack;
                    halign: center;
                    margin-top: 8;
                    margin-bottom: 0;
                }

                Stack navigation_stack {
                    vexpand: true;

                    StackPage {
                        name: "vault";
                        title: "Vault";
                        child: $VaultView vault_view {};
                    }

                    StackPage {
                        name: "changes";
                        title: "Changes";
                        child: $ChangesView changes_view {};
                    }
                }
            };

            end-child: $EntryView entry_view {};
        };
    };
}
