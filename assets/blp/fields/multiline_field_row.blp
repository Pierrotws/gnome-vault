using Gtk 4.0;

template $MultilineFieldRow : ListBoxRow {
    child: Box {
        orientation: vertical;
        spacing: 8;
        margin-top: 8;
        margin-bottom: 8;
        margin-start: 8;
        margin-end: 8;

        Box {
            orientation: horizontal;
            spacing: 8;

            Image drag_handle {
                icon-name: "list-drag-handle-symbolic";
                tooltip-text: _("Drag to reorder");
                valign: center;
                css-classes: ["dim-label"];
            }

            Entry title_entry {
                placeholder-text: _("Key");
                hexpand: true;
                css-classes: ["heading"];
            }

            Button copy_button {
                icon-name: "edit-copy-symbolic";
                tooltip-text: _("Copy value");
                valign: center;
            }

            Button delete_button {
                icon-name: "user-trash-symbolic";
                tooltip-text: _("Delete field");
                valign: center;
            }
        }

        Label value_label {
            wrap: true;
            xalign: 0;
            selectable: true;
            margin-top: 8;
            margin-bottom: 8;
            margin-start: 8;
            margin-end: 8;
        }

        ScrolledWindow value_scrolled_window {
            min-content-height: 96;
            max-content-height: 220;
            propagate-natural-height: true;

            child: TextView value_text_view {
                wrap-mode: word_char;
                top-margin: 8;
                bottom-margin: 8;
                left-margin: 8;
                right-margin: 8;
            };
        }
    };
}
