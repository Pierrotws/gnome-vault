using Gtk 4.0;

template $ChangesView : Gtk.Box {
    orientation: vertical;
    spacing: 8;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;
    width-request: 360;

    Box {
        orientation: horizontal;
        spacing: 8;

        Label {
            label: "Changes";
            xalign: 0;
            hexpand: true;
            css-classes: ["heading"];
        }

        Button push_button {
            label: "Push";
            tooltip-text: "Push local changes";
            visible: false;
            valign: center;
        }
    }

    Label empty_label {
        label: "No changes";
        xalign: 0;
        css-classes: ["dim-label"];
    }

    ScrolledWindow {
        vexpand: true;
        hexpand: true;

        child: Box changes_box {
            orientation: vertical;
            spacing: 6;
            valign: start;
        };
    }
}
