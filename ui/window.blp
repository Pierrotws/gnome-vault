using Gtk 4.0;
using Adw 1;

template $MainWindow : Adw.ApplicationWindow {
  title: "Vault";
  default-width: 1200;
  default-height: 720;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: "Gnome Vault";
        subtitle: "Unlocked";
      };

      [start]
      Button new_entry_button {
        icon-name: "list-add-symbolic";
        tooltip-text: "New Entry";
      }

      [end]
      MenuButton security_menu_button {
        icon-name: "system-lock-screen-symbolic";
        tooltip-text: "Security";

        popover: Popover {
          child: Box {
            orientation: vertical;
            spacing: 6;
            margin-top: 6;
            margin-bottom: 6;
            margin-start: 6;
            margin-end: 6;

            Button lock_vault_button {
              label: "Lock Vault";
              halign: fill;
            }

            Button lock_timeout_button {
              label: "Lock After Timeout";
              halign: fill;
            }

            Button clear_clipboard_button {
              label: "Clear Clipboard";
              halign: fill;
            }

            Separator {}

            Button vault_settings_button {
              label: "Vault Settings";
              halign: fill;
            }
          };
        };
      }
    }

    content: Paned {
      orientation: horizontal;
      wide-handle: true;
      position: 400;
      shrink-start-child: false;
      shrink-end-child: false;

      start-child: Box {
        orientation: vertical;
        spacing: 8;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;
        width-request: 360;

        SearchEntry tree_search_entry {
          placeholder-text: "Search entries and groups";
        }

        ScrolledWindow {
          vexpand: true;
          hexpand: true;

          child: ListView tree_view {
            single-click-activate: true;
          };
        }
      };

      end-child: Stack content_stack {
        vexpand: true;

        StackPage {
            name: "empty";
            child: Box {
              vexpand: true;
              valign: center;
              halign: center;
              orientation: vertical;
              spacing: 12;

              Label {
                label: "No entry selected";
                css-classes: ["title-3"];
              }

              Label {
                label: "Select an item from the tree";
                css-classes: ["dim-label"];
              }
            };
          }

        StackPage {
          name: "content";
          child: ScrolledWindow {
            vexpand: true;
            hexpand: true;

            child: Box {
              vexpand: true;
              orientation: vertical;
              spacing: 18;
              margin-top: 18;
              margin-bottom: 18;
              margin-start: 18;
              margin-end: 18;

              Label title_label {
                label: "";
                xalign: 0;
                halign: center;
                css-classes: ["title-2"];
              }

              Adw.PreferencesGroup {
                margin-top: 12;
                margin-bottom: 12;

                Adw.PasswordEntryRow password_row {
                  text: "";

                  [suffix]
                  Button copy_password_button {
                    icon-name: "edit-copy-symbolic";
                    tooltip-text: "Copy password";
                    valign: center;
                  }

                  [suffix]
                  Button generate_password_button {
                    icon-name: "view-refresh-symbolic";
                    tooltip-text: "Generate password";
                    valign: center;
                    margin-start: 6;
                  }
                }
              }

              Adw.PreferencesGroup {
                title: "Custom Fields";
                margin-top: 24;
                vexpand: true;

                Box {
                  orientation: vertical;
                  spacing: 8;
                  vexpand: true;

                  ScrolledWindow {
                    min-content-height: 0;
                    max-content-height: 320;
                    propagate-natural-height: true;
                    vexpand: false;

                    child: ListBox custom_fields_list {
                      selection-mode: none;
                      css-classes: ["boxed-list"];
                    };
                  }

                  Adw.ActionRow {
                    [suffix]
                    Button add_field_button {
                      label: "Add Field";
                      icon-name: "list-add-symbolic";
                      valign: center;
                    }
                  }
                }
              }

              Box footer_actions {
                orientation: horizontal;
                spacing: 12;
                margin-top: 12;
                margin-bottom: 6;
                vexpand: false;
                hexpand: true;

                Box {
                  orientation: horizontal;
                  spacing: 12;
                  halign: start;
                  hexpand: true;

                  Button delete_button {
                    label: "Delete Entry";
                    css-classes: ["destructive-action"];
                  }
                }

                Box {
                  orientation: horizontal;
                  spacing: 12;
                  halign: end;

                  Button cancel_button {
                    label: "Cancel";
                  }

                  Button save_button {
                    label: "Save";
                    css-classes: ["suggested-action"];
                  }
                }
              }
            };
          };
        }
      };
    };
  };
}
