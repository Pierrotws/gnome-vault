msgid "Get started"
msgstr "Loslegen"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "I already have a vault"
msgstr "Ich habe bereits einen Tresor"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Import a key"
msgstr "Schlüssel importieren"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "It already holds a vault"
msgstr "Es enthält bereits einen Tresor"

