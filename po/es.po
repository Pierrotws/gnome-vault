msgstr "Te damos la bienvenida a Passel"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Where is the vault on this phone?"
msgstr "¿Dónde está la bóveda en este teléfono?"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Where is your vault?"
msgstr "¿Dónde está tu bóveda?"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Where on this phone?"
msgstr "¿Dónde en este teléfono?"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Where to keep your vault?"
msgstr "¿Dónde guardar tu bóveda?"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"With a copy in a folder or a file you choose: an SD card, a USB drive, or a "
"folder synced by Syncthing or Nextcloud."
msgstr ""
"Con una copia en una carpeta o un archivo que elijas: una tarjeta SD, una "
"memoria USB o una carpeta sincronizada por Syncthing o Nextcloud."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Your email"
msgstr "Tu correo electrónico"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
