#: src/ui/setup_wizard/mod.rs
msgid "Download the vault"
msgstr "Descargar la bóveda"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
#: assets/ui/setup_wizard.ui
msgid "Email (optional)"
msgstr "Correo electrónico (opcional)"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Empty: ready for a new vault"
msgstr "Vacío: listo para una bóveda nueva"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"Entries are encrypted with an OpenPGP key. To open a vault made on a "
"computer, import the backup of its key (gpg --export-secret-keys --armor "
"<id>). A new vault can use a key created here."
msgstr ""
"Las entradas se cifran con una clave OpenPGP. Para abrir una bóveda creada "
"en un equipo, importa la copia de seguridad de su clave (gpg --export-secret-"
"keys --armor <id>). Una bóveda nueva puede usar una clave creada aquí."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Found a vault"
msgstr "Se encontró una bóveda"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Get a key:"
msgstr "Obtener una clave:"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"Get it from Google Drive, a git repository, or a folder or file: made with "
"Passel, or with pass and git."
msgstr ""
"Obtenla de Google Drive, de un repositorio git o de una carpeta o un "
"archivo: creada con Passel, o con pass y git."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Get started"
msgstr "Empezar"

