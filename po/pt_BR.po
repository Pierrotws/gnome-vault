#: assets/ui/setup_wizard.ui src/ui/setup_wizard/key.rs
#: src/ui/setup_wizard/sync.rs
msgid "Next"
msgstr "Próximo"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "No Passel vault on this Google Drive"
msgstr "Nenhum cofre do Passel neste Google Drive"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Nothing chosen yet"
msgstr "Nada escolhido ainda"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Nothing found at this address"
msgstr "Nada encontrado neste endereço"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "On this phone"
msgstr "Neste telefone"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Or add another key:"
msgstr "Ou adicionar outra chave:"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"Passel keeps a copy in one “.bundle” file, easy to move or send. On a "
"computer, git clone opens it."
msgstr ""
"O Passel guarda uma cópia num único arquivo “.bundle”, fácil de mover ou "
"enviar. No computador, o git clone o abre."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"Passel keeps a copy named “passwords.git” in the folder you choose: a git "
"repository, which pass and Passel on a computer open too."
msgstr ""
"O Passel guarda uma cópia chamada “passwords.git” na pasta que você "
"escolher: um repositório git, que o pass e o Passel também abrem no "
"computador."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"Passel keeps your passwords in a pass vault: one encrypted file per entry, "
"with its whole history. Keep it on your Google Drive, in a git repository, "
"or in a folder or file of your own."
msgstr ""
"O Passel guarda suas senhas em um cofre do pass: um arquivo criptografado "
"por entrada, com todo o histórico. Guarde-o no seu Google Drive, num "
"repositório git, ou numa pasta ou arquivo seu."

#. Translators: the name given to pass's default vault folder
#. (~/.password-store); the user can rename it.
#. Translators: default names of a new vault.
#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
#: crates/passel-core/src/app/vaults.rs crates/passel-ffi/src/vaults.rs
msgid "Passwords"
msgstr "Senhas"

#. Translators: tag of the recommended choice.
#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Recommended"
msgstr "Recomendado"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Save a backup"
msgstr "Salvar um backup"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"Saved on your Google account and synced with your other phones: just sign "
"in. Passel only sees the files it makes there."
msgstr ""
"Salvo na sua conta Google e sincronizado com seus outros telefones: basta "
"entrar. O Passel só vê os arquivos que cria lá."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Set up Passel"
msgstr "Configurar o Passel"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Setting it up takes a few steps: your key, then your vault."
msgstr "A configuração leva poucas etapas: sua chave e, depois, seu cofre."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Share public key"
msgstr "Compartilhar chave pública"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Share the public key"
msgstr "Compartilhar a chave pública"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Sign in with Google"
msgstr "Entrar com o Google"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Start an empty vault, encrypted with your key."
msgstr "Começar um cofre vazio, criptografado com sua chave."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Step {step} of {total}"
msgstr "Etapa {step} de {total}"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"The HTTPS address of its repository, and a personal access token allowed to "
"read and write it (GitHub: a fine-grained token with Contents read and "
"write)."
msgstr ""
"O endereço HTTPS do repositório e um token de acesso pessoal com permissão "
"de leitura e escrita nele (GitHub: um token fine-grained com Contents em "
"leitura e escrita)."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "The changes you make from this phone are signed with:"
msgstr "As alterações feitas neste telefone são assinadas com:"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "The server refused this username or token"
msgstr "O servidor recusou este nome de usuário ou token"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"The “passwords.git” folder made by Passel or git, or the folder holding it."
msgstr ""
"A pasta “passwords.git” criada pelo Passel ou pelo git, ou a pasta que a "
"contém."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "This Google Drive already holds {n} vault."
msgid_plural "This Google Drive already holds {n} vaults."
msgstr[0] "Este Google Drive já tem {n} cofre."
msgstr[1] "Este Google Drive já tem {n} cofres."

