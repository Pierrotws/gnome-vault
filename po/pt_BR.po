"Access denied. HTTPS addresses need a saved password or token: use the SSH "
"address instead."
msgstr ""
"Acesso negado. Endereços HTTPS exigem uma senha ou um token salvo: use o "
"endereço SSH."

#. Translators: {service} is GitHub, GitLab…
#: src/ui/setup_wizard/sync.rs
#, rust-format
msgid "Add your SSH key to {service}"
msgstr "Adicione sua chave SSH ao {service}"

#: src/ui/setup_wizard/sync.rs
msgid "Checking the address…"
msgstr "Verificando o endereço…"

#: src/ui/setup_wizard/sync.rs
msgid "Choose a Folder for the Copy"
msgstr "Escolher uma pasta para a cópia"

#: src/ui/setup_wizard/sync.rs
msgid "Continue Anyway"
msgstr "Continuar mesmo assim"

#: src/ui/setup_wizard/sync.rs
msgid "Copy Key"
msgstr "Copiar chave"

#: src/ui/setup_wizard/sync.rs
msgid "How to Create One"
msgstr "Como criar um"

#: src/ui/setup_wizard/sync.rs
msgid "I already have one"
msgstr "Já tenho um"

#: src/ui/setup_wizard/sync.rs
msgid ""
"No repository found at this address. Check the address and your internet "
"connection."
msgstr ""
"Nenhum repositório encontrado neste endereço. Verifique o endereço e sua "
"conexão com a internet."

#: src/ui/setup_wizard/sync.rs
msgid "Open the SSH Keys Page"
msgstr "Abrir a página de chaves SSH"

#. Translators: {service} is GitHub, GitLab…
#: src/ui/setup_wizard/sync.rs
#, rust-format
msgid "Open {service}"
msgstr "Abrir {service}"

#: src/ui/setup_wizard/sync.rs
msgid "Ready: the repository exists and is empty."
msgstr "Pronto: o repositório existe e está vazio."

#: src/ui/setup_wizard/sync.rs
msgid "SSH address, like git@server:you/passwords.git"
msgstr "Endereço SSH, como git@servidor:usuario/passwords.git"

#: src/ui/setup_wizard/sync.rs
msgid "Sign in or create a free account, then start a new repository"
msgstr "Entre ou crie uma conta gratuita e depois crie um repositório novo"

#: src/ui/setup_wizard/sync.rs
msgid ""
"This computer has no SSH key yet. Create one, then add it to your account."
msgstr ""
"Este computador ainda não tem chave SSH. Crie uma e depois adicione-a à sua "
"conta."

#: src/ui/setup_wizard/sync.rs
msgid "This folder already has a “passwords.bundle”. Choose another folder."
msgstr "Esta pasta já tem um “passwords.bundle”. Escolha outra pasta."

#: src/ui/setup_wizard/sync.rs
msgid "This folder already has a “passwords.git”. Choose another folder."
msgstr "Esta pasta já contém um “passwords.git”. Escolha outra pasta."

#: src/ui/setup_wizard/sync.rs
msgid "This folder is inside the vault. Choose a folder outside it."
msgstr "Esta pasta fica dentro do cofre. Escolha uma pasta fora dele."

#: src/ui/setup_wizard/sync.rs
msgid "This folder’s name has unsupported characters. Choose another folder."
msgstr ""
"O nome desta pasta contém caracteres não suportados. Escolha outra pasta."

#: src/ui/setup_wizard/sync.rs
#, rust-format
msgid ""
"This lets Passel upload. Copy your key ({file}), then add it on the SSH keys "
"page."
msgstr ""
"Ela permite que o Passel envie dados. Copie sua chave ({file}) e depois "
"adicione-a na página de chaves SSH."

#: src/ui/setup_wizard/sync.rs
msgid ""
"This repository already has content. Create a new, empty one for the vault."
msgstr "Este repositório já tem conteúdo. Crie um novo, vazio, para o cofre."

#: src/ui/setup_wizard/sync.rs
msgid ""
"This server isn’t in your known SSH hosts yet. Connect to it once with ssh "
"in a terminal, then check again."
msgstr ""
"Este servidor ainda não está nos seus hosts SSH conhecidos. Conecte-se a ele "
"uma vez com ssh em um terminal e depois verifique novamente."

#: src/ui/setup_wizard/sync.rs
msgid "This service only accepts RSA keys, and this computer has none yet."
msgstr ""
"Este serviço só aceita chaves RSA, e este computador ainda não tem nenhuma."

#: src/ui/vault_view/mod.rs
msgid "Create Entry"
msgstr "Criar entrada"

#: src/ui/vault_view/mod.rs
msgid "Delete Folder"
msgstr "Excluir pasta"

#: src/ui/window/group_content.rs
#, rust-format
msgid "Results for “{query}”"
msgstr "Resultados para “{query}”"

#. Translators: {entries} is "1 entry" or "5 entries".
#: src/ui/window/import_dialog.rs
#, rust-format
msgid "Added {entries} to the vault."
msgstr "Adicionado ao cofre: {entries}."

#. Translators: {entries} is "1 entry" or "5 entries".
#: src/ui/window/import_dialog.rs
#, rust-format
msgid "Added {entries} to “{folder}”."
msgstr "Adicionado a “{folder}”: {entries}."

#: src/ui/window/import_dialog.rs
msgid "Buttercup vaults"
msgstr "Cofres do Buttercup"

#: src/ui/window/import_dialog.rs
msgid "Choose a File to Import"
msgstr "Escolher um arquivo para importar"

#: src/ui/window/import_dialog.rs
msgid "Encrypting and saving the entries…"
msgstr "Criptografando e salvando as entradas…"

#: src/ui/window/import_dialog.rs
msgid "File"
msgstr "Arquivo"

#: src/ui/window/import_dialog.rs
msgid "Folder in this vault"
msgstr "Pasta neste cofre"

#. Translators: {entries} is "1 entry" or "5 entries",
#. {groups} is "1 group" or "3 groups".
#: src/ui/window/import_dialog.rs
#, rust-format
msgid "Found {entries} in {groups} (the trash is left out)."
msgstr "Encontrado: {entries} em {groups} (lixeira excluída)."

#: src/ui/window/import_dialog.rs
msgid "From"
msgstr "De"

#: src/ui/window/import_dialog.rs
msgid ""
"Groups become folders inside it. A name already in use gets a number, e.g. "
"“Bank (2)”."
msgstr ""
"Os grupos viram pastas dentro dela. Um nome já usado recebe um número, por "
"exemplo “Banco (2)”."

#: src/ui/window/import_dialog.rs
msgid "Import Finished"
msgstr "Importação concluída"

#: src/ui/window/import_dialog.rs
msgid "Import Passwords"
msgstr "Importar senhas"

#: src/ui/window/import_dialog.rs
#, rust-format
msgid "Import {n} Entry"
msgid_plural "Import {n} Entries"
msgstr[0] "Importar {n} entrada"
msgstr[1] "Importar {n} entradas"

#. Translators: the suggested folder for imported entries;
#. {source} is KeePassXC or Buttercup.
#: src/ui/window/import_dialog.rs
#, rust-format
msgid "Imported/{source}"
msgstr "Importado/{source}"

#: src/ui/window/import_dialog.rs
msgid "Into"
msgstr "Para"

#: src/ui/window/import_dialog.rs
msgid "KeePassXC databases"
msgstr "Bancos de dados do KeePassXC"

#: src/ui/window/import_dialog.rs
msgid "Master password"
msgstr "Senha mestra"

#: src/ui/window/import_dialog.rs
msgid "Open File"
msgstr "Abrir arquivo"

#: src/ui/window/import_dialog.rs
msgid "Opening the file…"
msgstr "Abrindo o arquivo…"

#: src/ui/window/import_dialog.rs
msgid ""
"The entries were added to the vault and saved, but uploading them failed. "
"Use Changes to try again."
msgstr ""
"As entradas foram adicionadas ao cofre e salvas, mas o envio falhou. Use "
"Alterações para tentar novamente."

#: src/ui/window/import_dialog.rs
#, rust-format
msgid ""
"The entries were added to “{folder}” and saved, but uploading them failed. "
"Use Changes to try again."
msgstr ""
"As entradas foram adicionadas a “{folder}” e salvas, mas o envio falhou. Use "
"Alterações para tentar novamente."

#: src/ui/window/import_dialog.rs
msgid "The import stopped unexpectedly"
msgstr "A importação parou inesperadamente"

#: src/ui/window/import_dialog.rs
msgid "The master password only opens the file here; Passel does not keep it."
msgstr "A senha mestra só abre o arquivo aqui; o Passel não a guarda."

#: src/ui/window/import_dialog.rs
msgid "This file has no entries to import."
msgstr "Este arquivo não tem entradas para importar."

#: src/ui/window/import_dialog.rs
#, rust-format
msgid "{n} entry got a number because the name was already in use."
msgid_plural "{n} entries got a number because the name was already in use."
msgstr[0] "{n} entrada recebeu um número porque o nome já estava em uso."
msgstr[1] "{n} entradas receberam um número porque o nome já estava em uso."

#: src/ui/window/import_dialog.rs
#, rust-format
msgid "{n} group"
msgid_plural "{n} groups"
msgstr[0] "{n} grupo"
msgstr[1] "{n} grupos"

#: src/ui/window/mod.rs
#, rust-format
msgid ""
"A backup was saved to the remote as “{branch}” in case you need to recover."
msgstr ""
"Um backup foi salvo no repositório remoto como “{branch}”, caso você precise "
"recuperar algo."

#: src/ui/window/mod.rs
msgid "Changes discarded"
msgstr "Alterações descartadas"

#: src/ui/window/mod.rs
#, rust-format
msgid "Delete “{name}”?"
msgstr "Excluir “{name}”?"

#: src/ui/window/mod.rs
msgid "Discard changes after this point?"
msgstr "Descartar as alterações a partir deste ponto?"

#: src/ui/window/mod.rs
msgid "Discard-changes task panicked unexpectedly"
msgstr "O descarte de alterações parou inesperadamente"

#: src/ui/window/mod.rs
msgid "Save or cancel current changes before deleting a folder"
msgstr "Salve ou cancele as alterações atuais antes de excluir uma pasta"

#: src/ui/window/mod.rs
msgid "Save or cancel current changes before deleting an entry"
msgstr "Salve ou cancele as alterações atuais antes de excluir uma entrada"

#: src/ui/window/mod.rs
msgid "Save or cancel current changes before discarding later changes"
msgstr ""
"Salve ou cancele as alterações atuais antes de descartar as alterações "
"posteriores"

#: src/ui/window/mod.rs
msgid "Save or cancel current changes before undoing a change"
msgstr "Salve ou cancele as alterações atuais antes de desfazer uma alteração"

#: src/ui/window/mod.rs
msgid "Sync-to-remote task panicked unexpectedly"
msgstr "A sincronização com o repositório remoto parou inesperadamente"

#: src/ui/window/mod.rs
msgid "The entry is removed and a single commit is recorded."
msgstr "A entrada é excluída e um único commit é registrado."

#: src/ui/window/mod.rs
msgid "Undo"
msgstr "Desfazer"

#: src/ui/window/mod.rs
msgid "Undo task panicked unexpectedly"
msgstr "A operação de desfazer parou inesperadamente"

#: src/ui/window/mod.rs
msgid "Undo this change?"
msgstr "Desfazer esta alteração?"

#: src/ui/window/new_entry_dialog.rs
msgid "Save or cancel current changes before creating a new entry"
msgstr "Salve ou cancele as alterações atuais antes de criar uma entrada nova"

#. Translators: {folder} is a folder path, in bold.
#: src/ui/window/setup.rs
#, rust-format
msgid ""
"<b>{folder}</b> holds a password store whose changes are not recorded. "
"Passel can keep a history of every change so you can undo it and sync it "
"with a remote. Your entries stay as they are."
msgstr ""
"<b>{folder}</b> contém um armazenamento de senhas cujas alterações não são "
"registradas. O Passel pode manter um histórico de cada alteração para que "
"você possa desfazê-la e sincronizá-la com um repositório remoto. Suas "
"entradas continuam como estão."

#: src/ui/window/setup.rs
msgid "New Vault"
msgstr "Novo cofre"

#: src/ui/window/setup.rs src/ui/window/vaults.rs
msgid "No history"
msgstr "Sem histórico"

#: src/ui/window/unsaved.rs
msgid "Discard changes?"
msgstr "Descartar alterações?"

#: src/ui/window/unsaved.rs
msgid "The changes to this entry have not been saved."
msgstr "As alterações desta entrada não foram salvas."

#: src/ui/window/unsaved.rs
msgid "_Discard"
msgstr "_Descartar"

#. Translators: {folder} is a folder path, in bold.
#: src/ui/window/vaults.rs
#, rust-format
msgid ""
"<b>{folder}</b> was not found, or holds no vault. If it is on a drive, plug "
"it in and switch to this vault again."
msgstr ""
"<b>{folder}</b> não foi encontrada ou não contém um cofre. Se estiver em uma "
"unidade externa, conecte-a e mude para este cofre novamente."

#: src/ui/window/vaults.rs
msgid "Branch (empty: current branch)"
msgstr "Branch (vazio: branch atual)"

#: src/ui/window/vaults.rs
msgid "Copied to a file"
msgstr "Copiado num arquivo"

#: src/ui/window/vaults.rs
#, rust-format
msgid "Could not save the vault list: {error}"
msgstr "Não foi possível salvar a lista de cofres: {error}"

#: src/ui/window/vaults.rs
msgid "Folder not found"
msgstr "Pasta não encontrada"

#: src/ui/window/vaults.rs
msgid "History"
msgstr "Histórico"

#: src/ui/window/vaults.rs
msgid "Leave the address empty to keep this vault on this computer only."
msgstr ""
"Deixe o endereço vazio para manter este cofre somente neste computador."

#: src/ui/window/vaults.rs
msgid "Off: changes are saved but not recorded."
msgstr ""
"Desativado: as alterações são salvas, mas não registradas no histórico."

#: src/ui/window/vaults.rs
msgid "On: every change is recorded and can be undone."
msgstr "Ativado: cada alteração é registrada no histórico e pode ser desfeita."

#: src/ui/window/vaults.rs
msgid "Open a Vault Folder"
msgstr "Abrir uma pasta de cofre"

#: src/ui/window/vaults.rs
msgid "Push changes automatically"
msgstr "Enviar alterações automaticamente"

#: src/ui/window/vaults.rs
msgid "Remote address"
msgstr "Endereço do repositório remoto"

#: src/ui/window/vaults.rs
msgid "The folder and its entries stay on disk."
msgstr "A pasta e as entradas dela continuam no disco."

#: src/ui/window/vaults.rs
msgid "Turn On"
msgstr "Ativar"

#: src/ui/window/vaults.rs
msgid "Upload after every saved change"
msgstr "Enviar após cada alteração salva"

#: src/ui/window/vaults.rs
msgid "Vault Settings"
msgstr "Configurações do cofre"

#. Translators: a vault's state in the vault list.
#: src/ui/window/vaults.rs
msgid "history"
msgstr "com histórico"

#. Translators: a vault's state in the vault list.
#: src/ui/window/vaults.rs
msgid "history, synced"
msgstr "com histórico, sincronizado"

#. Translators: a vault's state in the vault list.
#: src/ui/window/vaults.rs
