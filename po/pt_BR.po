msgstr "Salvar um backup da sua chave"

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Save the backup"
msgstr "Salvar o backup"

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid ""
"The passphrase kept for biometric unlock no longer works: enter the key's "
"passphrase."
msgstr ""
"A frase secreta guardada para o desbloqueio biométrico não funciona mais: "
"digite a frase secreta da chave."

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Turn on biometric unlock"
msgstr "Ativar o desbloqueio biométrico"

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Unlock"
msgstr "Desbloquear"

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Unlock with biometrics next time"
msgstr "Desbloquear com biometria da próxima vez"

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Unlock your key"
msgstr "Desbloqueie sua chave"

#. Translators: button of the biometric prompt, to type the passphrase instead.
#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Use the passphrase"
msgstr "Usar a frase secreta"

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid ""
"Without it, losing this phone loses access to your vaults. The backup stays "
"protected by the key's passphrase: keep it somewhere safe, like Google Drive "
"or a computer."
msgstr ""
"Sem ele, perder este celular faz perder o acesso aos seus cofres. O backup "
"continua protegido pela frase secreta da chave: guarde-o em um lugar seguro, "
"como o Google Drive ou um computador."

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Wrong passphrase, try again"
msgstr "Frase secreta incorreta, tente novamente"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "A file"
msgstr "Um arquivo"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "A folder"
msgstr "Uma pasta"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"A folder or a file holding the vault: on this phone, an SD card, a USB "
"drive, or in a storage app."
msgstr ""
"Uma pasta ou um arquivo com o cofre: neste telefone, num cartão SD, num pen "
"drive ou num app de armazenamento."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "A vault that Passel saved to your Google Drive."
msgstr "Um cofre que o Passel salvou no seu Google Drive."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "A “.bundle” file made by Passel or git."
msgstr "Um arquivo “.bundle” criado pelo Passel ou pelo git."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Access token"
msgstr "Token de acesso"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
#: android/app/src/main/kotlin/io/pierrotws/passel/VaultScreen.kt
msgid "Add a vault"
msgstr "Adicionar um cofre"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Address (https://…)"
msgstr "Endereço (https://…)"

#. Translators: tag of a choice that needs some technical knowledge.
#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Advanced"
msgstr "Avançado"

#. Translators: tag of the git choice: it needs some technical knowledge, but is the most capable.
#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Advanced · recommended"
msgstr "Avançado · recomendado"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"An empty private repository you created for it (GitHub, GitLab…). Your vault "
"is backed up with its whole history, and opens with pass and Passel on your "
"computers too."
msgstr ""
"Um repositório privado vazio criado para isso (GitHub, GitLab…). Seu cofre "
"fica com backup de todo o histórico e também abre com pass e Passel nos seus "
"computadores."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Changed on {date}"
msgstr "Alterado em {date}"

#. Translators: button that checks a repository address.
