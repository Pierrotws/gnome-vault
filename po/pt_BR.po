#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Later"
msgstr "Mais tarde"

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Passphrase"
msgstr "Frase secreta"

#: android/app/src/main/kotlin/io/pierrotws/passel/MainActivity.kt
msgid "Repeat it"
msgstr "Repita-a"

