#: assets/ui/setup_wizard.ui
msgid "Check"
msgstr "Verificar"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Checking…"
msgstr "Verificando…"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
#: assets/ui/setup_wizard.ui src/ui/window/import_dialog.rs
msgid "Choose…"
msgstr "Escolher…"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Connected to Google Drive"
msgstr "Conectado ao Google Drive"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
