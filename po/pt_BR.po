msgid "Connecting to Google Drive"
msgstr "Conectando ao Google Drive"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Create a key"
msgstr "Criar uma chave"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Create a new vault"
msgstr "Criar um cofre novo"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Create a new vault there"
msgstr "Criar um cofre novo nele"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Create the vault"
msgstr "Criar o cofre"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Download it instead"
msgstr "Baixá-lo em vez disso"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Download the vault"
msgstr "Baixar o cofre"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
#: assets/ui/setup_wizard.ui
msgid "Email (optional)"
msgstr "E-mail (opcional)"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Empty: ready for a new vault"
msgstr "Vazio: pronto para um cofre novo"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"Entries are encrypted with an OpenPGP key. To open a vault made on a "
"computer, import the backup of its key (gpg --export-secret-keys --armor "
"<id>). A new vault can use a key created here."
msgstr ""
"As entradas são criptografadas com uma chave OpenPGP. Para abrir um cofre "
"criado em um computador, importe o backup da chave dele (gpg --export-secret-"
"keys --armor <id>). Um cofre novo pode usar uma chave criada aqui."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Found a vault"
msgstr "Cofre encontrado"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Get a key:"
msgstr "Obter uma chave:"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid ""
"Get it from Google Drive, a git repository, or a folder or file: made with "
"Passel, or with pass and git."
msgstr ""
"Pegue-o do Google Drive, de um repositório git ou de uma pasta ou arquivo: "
"criado com o Passel, ou com pass e git."

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Get started"
msgstr "Começar"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Git repository"
msgstr "Repositório git"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Google Drive"
msgstr "Google Drive"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "I already have a vault"
msgstr "Já tenho um cofre"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "Import a key"
msgstr "Importar uma chave"

#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
msgid "It already holds a vault"
msgstr "Ele já contém um cofre"

#. Translators: shown for a key without a name.
#: android/app/src/main/kotlin/io/pierrotws/passel/SetupWizard.kt
#: assets/ui/setup_wizard.ui
msgid "Key"
msgstr "Chave"

