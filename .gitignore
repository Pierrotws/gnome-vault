# Cargo / Rust
/target/
/Cargo.lock.bak

# Meson
/build/
/builddir/

# makepkg working dirs and outputs (left in place when running makepkg
# inside packaging/arch/<pkg>/)
/packaging/arch/*/src/
/packaging/arch/*/pkg/
/packaging/arch/*/*.pkg.tar.*
/packaging/arch/*/*.tar.gz
/packaging/arch/*/*.tar.zst
/packaging/arch/*/passel-[0-9]*/
/packaging/arch/*/passel-bin-[0-9]*/

# Windows install tree and installer (packaging/windows/README.md)
/dist/
/packaging/windows/*.exe

# Editor / OS
.DS_Store
*.swp

# Sandbox vault used by debug builds (cargo run)
/.dev-password-store/
/.dev-password-store.passel-settings.ini
